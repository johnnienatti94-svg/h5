# =============================================================================
# MeePro Official Production Environment Configuration Reference (.env.example)
# Specification Reference: MeePro_Full_Stack_Build_Prompt.md (24 September 2026)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Base Application & Public URLs
# -----------------------------------------------------------------------------
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://www.meeprochat.online
PORT=3000

# -----------------------------------------------------------------------------
# 2. Database & Supabase Platform (Authoritative Domain Store)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Compatibility Aliases
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SECRET_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -----------------------------------------------------------------------------
# 3. Session Security & Cryptographic Secrets (Min 32 characters)
# -----------------------------------------------------------------------------
# Customer phone OTP session cookie (meepro_customer_session) signing secret
CUSTOMER_SESSION_SECRET=replace-with-a-64-character-cryptographically-random-customer-secret

# Staff portal session cookie (meepro_staff_session) HMAC signing secret
STAFF_SESSION_SECRET=replace-with-a-64-character-cryptographically-random-staff-secret

# Order & ledger tamper-proof integrity HMAC signing secret
COMMERCE_SIGNING_SECRET=replace-with-a-64-character-cryptographically-random-commerce-secret

# -----------------------------------------------------------------------------
# 4. Anti-Bot & CAPTCHA (Cloudflare Turnstile)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAx...
TURNSTILE_SECRET_KEY=0x4AAAAAAAx...

# -----------------------------------------------------------------------------
# 5. SMS & OTP Gateway Providers
# -----------------------------------------------------------------------------
# Supported OTP Providers: SupabaseAuth | ThaiBulkSMS | Twilio | AWS_SNS
OTP_PROVIDER=SupabaseAuth
OTP_EXPIRY_SECONDS=300
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=3

# ThaiBulkSMS Integration (when OTP_PROVIDER=ThaiBulkSMS)
# THAIBULKSMS_API_KEY=your-api-key
# THAIBULKSMS_API_SECRET=your-api-secret
# THAIBULKSMS_SENDER_NAME=MEEPRO

# Twilio SMS Integration (when OTP_PROVIDER=Twilio)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_FROM_PHONE=+1234567890

# -----------------------------------------------------------------------------
# 6. S3 Compatible Storage (Public Assets & Private Application Documents)
# -----------------------------------------------------------------------------
# AWS_REGION=ap-southeast-1
# S3_PUBLIC_BUCKET=meepro-public-media
# S3_SECURE_APPLICATIONS_BUCKET=meepro-private-applications
# S3_ACCESS_KEY_ID=your-s3-access-key
# S3_SECRET_ACCESS_KEY=your-s3-secret-key
